{% extends "base-template.jinja2" %}

    {% block body %}
          <h1>{{ gettext("Admin dashboard") }}</h1>

          <h2>{{ gettext("Documents") }}</h2>
          <table>
            <tr><td>{{ gettext("Number of documents") }}</td><td>{{ total_docs }}</td></tr>
            <tr><td>{{ gettext("Total bytes") }}</td><td>{{ total_bytes }}</td></tr>
            <tr><td>{{ gettext("Number of documents to purge") }}</td><td>{{ old_docs }}</td></tr>
            <tr><td>{{ gettext("Total bytes to purge") }}</td><td>{{ old_bytes }}</td></tr>
          </table>

          <h2>{{ gettext("Documents created per day") }}</h2>
          {% if histogram %}
          <svg id="docs-per-day" viewBox="0 0 {{ 50 + histogram|length * 30 }} 280" width="{{ 50 + histogram|length * 30 }}" height="280" xmlns="http://www.w3.org/2000/svg">
            <line x1="40" y1="210" x2="{{ 45 + histogram|length * 30 }}" y2="210" stroke="#455" stroke-width="1" />
            {% for bucket in histogram %}
            {% set height = (bucket.count / max_count * 180) | round(1) %}
            {% set x = 45 + loop.index0 * 30 %}
            <rect x="{{ x }}" y="{{ 210 - height }}" width="24" height="{{ height }}" fill="#28a745" />
            <text x="{{ x + 12 }}" y="{{ 204 - height }}" font-size="11" text-anchor="middle" fill="#455">{{ bucket.count }}</text>
            <text x="{{ x + 12 }}" y="222" font-size="10" text-anchor="end" fill="#455" transform="rotate(-45 {{ x + 12 }} 222)">{{ bucket.day }}</text>
            {% endfor %}
          </svg>
          {% else %}
          <p>{{ gettext("No documents") }}</p>
          {% endif %}

          {% macro usage_table(table_id, rows) %}
          {% if rows %}
          <table id="{{ table_id }}" class="id-service-usage">
            <tr>
              <th rowspan="2">{{ gettext("Organization") }}</th>
              <th colspan="2">{{ gettext("BankID") }}</th>
              <th colspan="2">{{ gettext("Freja") }}</th>
            </tr>
            <tr>
              <th>{{ gettext("within quota") }}</th>
              <th>{{ gettext("over quota") }}</th>
              <th>{{ gettext("within quota") }}</th>
              <th>{{ gettext("over quota") }}</th>
            </tr>
            {% for row in rows %}
            <tr>
              <td>{{ row.organization }}</td>
              {% for sigs in (row.bankid, row.freja) %}
              <td>{{ sigs.within }}</td>
              {% if sigs.over is none %}
              <td>-</td>
              {% elif sigs.over > 0 %}
              <td class="over-quota" style="color: #a00; font-weight: bold;">{{ sigs.over }}</td>
              {% else %}
              <td>{{ sigs.over }}</td>
              {% endif %}
              {% endfor %}
            </tr>
            {% endfor %}
          </table>
          {% else %}
          <p>{{ gettext("No signatures") }}</p>
          {% endif %}
          {% endmacro %}

          <style>
            .id-service-usage { border-collapse: collapse; }
            .id-service-usage th, .id-service-usage td { border: 1px solid #455; padding: 0.3em 0.8em; text-align: center; }
          </style>

          <h2>{{ gettext("BankID and Freja logins and signatures this month") }} ({{ month_label }})</h2>
          {{ usage_table("id-service-usage", usage) }}

          <h2>{{ gettext("BankID and Freja logins and signatures last month") }} ({{ prev_month_label }})</h2>
          {{ usage_table("id-service-usage-prev", usage_prev) }}

          <h2>{{ gettext("BankID and Freja logins and signatures per month") }}</h2>
          {% if months %}
          <svg id="eid-per-month" viewBox="0 0 {{ 100 + months|length * 60 }} 260" width="{{ 100 + months|length * 60 }}" height="260" xmlns="http://www.w3.org/2000/svg">
            {% for tick in y_ticks %}
            <line x1="60" y1="{{ tick.y }}" x2="{{ 90 + months|length * 60 }}" y2="{{ tick.y }}" stroke="#ddd" stroke-width="1" />
            <line x1="56" y1="{{ tick.y }}" x2="60" y2="{{ tick.y }}" stroke="#455" stroke-width="1" />
            <text class="y-tick" x="52" y="{{ tick.y + 3.5 }}" font-size="10" text-anchor="end" fill="#455">{{ tick.value }}</text>
            {% endfor %}
            <line x1="60" y1="30" x2="60" y2="210" stroke="#455" stroke-width="1" />
            <line x1="60" y1="210" x2="{{ 90 + months|length * 60 }}" y2="210" stroke="#455" stroke-width="1" />
            {% for label in x_labels %}
            <line x1="{{ label.x }}" y1="210" x2="{{ label.x }}" y2="214" stroke="#455" stroke-width="1" />
            <text class="x-label" x="{{ label.x }}" y="226" font-size="10" text-anchor="middle" fill="#455">{{ label.label }}</text>
            {% endfor %}
            {% for s in series %}
            <polyline class="eid-series" points="{{ s.path }}" fill="none" stroke="{{ s.color }}" stroke-width="2">
              <title>{{ s.organization }}</title>
            </polyline>
            {% for p in s.points %}
            <circle cx="{{ p.x }}" cy="{{ p.y }}" r="4" fill="{{ s.color }}">
              <title>{{ s.organization }}: {{ p.count }}, {{ p.label }}</title>
            </circle>
            {% endfor %}
            {% endfor %}
          </svg>
          <ul id="eid-per-month-legend" style="list-style: none; padding: 0;">
            {% for s in series %}
            <li><span style="display: inline-block; width: 1em; height: 1em; background: {{ s.color }}; vertical-align: middle;"></span> {{ s.organization }}</li>
            {% endfor %}
          </ul>
          {% else %}
          <p>{{ gettext("No signatures") }}</p>
          {% endif %}
    {% endblock %}

    {% block foot_link %}
              <a href="/">
                {% trans %}Home{% endtrans %}
              </a>
    {% endblock %}
