{
  "name": "edusign-front",
  "version": "1.6.2b41",
  "description": "",
  "browser": "src/entry-points/index.js",
  "scripts": {
    "start": "rm -rf node_modules/.cache && webpack --watch --progress",
    "build-pro": "rm -rf node_modules/.cache && webpack --config webpack.prod.config.js",
    "build-dev": "rm -rf node_modules/.cache && webpack --config webpack.config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "coverage": "jest --coverage",
    "serve": "webpack-dev-server --open",
    "extract-msgs": "extract-messages -l=en,sv,es -o translations -d en --flat true 'src/**/!(*-test).js'",
    "prettier": "npx prettier --write src/",
    "build-docs": "jsdoc -c jsdoc.config.json src/"
  },
  "author": "Enrique Pérez Arnaud",
  "license": "BSD-2-Clause",
  "alias": {
    "components": "./src/components",
    "containers": "./src/containers",
    "init-app": "./src/init-app",
    "slices": "./src/slices",
    "styles": "./src/styles"
  },
